# --- HTTP ---
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# --- LLM ---
# groq (por defecto) | bedrock (Claude vía Amazon Bedrock; requiere acceso a modelos de Anthropic en la cuenta AWS)
LLM_PROVIDER=groq
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Bedrock: credenciales por la cadena estándar de AWS (aws login / perfil / rol IAM).
# No definir AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY ficticias aquí: tendrían prioridad.
AWS_REGION=us-east-2
BEDROCK_MODEL=anthropic.claude-haiku-5-5
# low | medium | high
BEDROCK_EFFORT=medium
BEDROCK_MAX_TOKENS=16000

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Búsqueda ---
# tavily | mock (mock no requiere key)
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
# Timeout de Tavily y de la lectura de páginas
HTTP_TIMEOUT_MS=10000

# --- DynamoDB Local ---
DYNAMO_ENDPOINT=http://localhost:8000
DYNAMO_TABLE=leads

# --- Guardas del agente ---
AGENT_MAX_ITERATIONS=20
AGENT_MAX_LEADS=10
