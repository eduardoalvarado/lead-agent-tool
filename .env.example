# --- HTTP ---
PORT=3000

# --- LLM ---
# groq | bedrock (bedrock es un stub documentado)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=30000

# --- Búsqueda ---
# tavily | mock (mock no requiere key)
SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# --- DynamoDB Local ---
DYNAMO_ENDPOINT=http://localhost:8000
DYNAMO_TABLE=leads
AWS_REGION=us-east-1
# Credenciales ficticias: DynamoDB Local las exige pero no las valida
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Guardas del agente ---
AGENT_MAX_ITERATIONS=10
AGENT_MAX_LEADS=10
