# --- HTTP ---
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info

# --- LLM ---
# groq (por defecto) | ollama (local) | openai-compatible (OpenRouter, Gemini, Cerebras…)
# | bedrock (Claude vía Amazon Bedrock; requiere acceso a modelos en la cuenta AWS)
LLM_PROVIDER=groq
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Proveedores compatibles con OpenAI. Cada preset trae URL y modelo por defecto:
#   groq   → https://api.groq.com/openai/v1 · openai/gpt-oss-120b (requiere LLM_API_KEY)
#   ollama → http://localhost:11434/v1 · qwen3:8b (sin key)
#   openai-compatible → exige LLM_BASE_URL, LLM_MODEL y LLM_API_KEY
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# low | medium | high (modelos de razonamiento como gpt-oss; el preset groq usa low)
LLM_REASONING_EFFORT=
# 0-2. Vacío = la del preset (groq/ollama: 0) o no se envía (openai-compatible).
# Déjala vacía con modelos que la rechazan, como Claude.
LLM_TEMPERATURE=

# Bedrock: credenciales por la cadena estándar de AWS (aws login / perfil / rol IAM).
# No definir AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY ficticias aquí: tendrían prioridad.
AWS_REGION=us-east-2
BEDROCK_MODEL=anthropic.claude-haiku-5-5
# low | medium | high
BEDROCK_EFFORT=medium
BEDROCK_MAX_TOKENS=16000

# --- Búsqueda ---
# tavily | mock (mock no requiere key)
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
# Timeout de Tavily y de la lectura de páginas
HTTP_TIMEOUT_MS=10000

# --- DynamoDB Local ---
DYNAMO_ENDPOINT=http://localhost:8000
DYNAMO_TABLE=leads

# --- Guardas del agente ---
AGENT_MAX_ITERATIONS=20
AGENT_MAX_LEADS=10
