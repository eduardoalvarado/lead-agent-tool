    },
    {
      "id": "tavily",
      "lane": "externos",
      "col": 3,
      "type": "external",
      "label": "Tavily / mock",
      "sublabel": "búsqueda web",
      "width": 140
    },
    {
      "id": "dynamo",
      "lane": "externos",
      "col": 4,
      "type": "database",
      "label": "DynamoDB",
      "sublabel": "dedupe por dominio",
      "width": 140
