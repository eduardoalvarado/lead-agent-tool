  "cards": [
    {
      "dot": "emerald",
      "title": "El LLM decide",
      "items": [
        "Cuándo buscar, leer, guardar o descartar",
        "Cuándo terminar con su propio resumen"
      ]
    },
    {
      "dot": "cyan",
      "title": "El código garantiza",
      "items": [
        "Validación Zod: el error vuelve al LLM para corregir",
        "Decidir lo encontrado antes de buscar más"
      ]
    },
    {
      "dot": "rose",
      "title": "Cortes controlados",
      "items": [
        "Máximo de iteraciones y de leads",
        "Fallo del LLM: llm_error con resumen parcial"
      ]
    }
  ]
}
