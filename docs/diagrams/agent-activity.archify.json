{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Lead Agent — Diagrama de actividades del bucle ReAct",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "ciclo",
        "label": "Ciclo ReAct",
        "focus": [
          "validate",
          "think",
          "act",
          "tools",
          "observe",
          "guard"
        ],
        "note": "Pensar → actuar con un tool → observar el resultado → repetir hasta terminar."
      },
      {
        "id": "efectos",
        "label": "Tools y servicios",
        "focus": [
          "act",
          "tools",
          "tavily",
          "dynamo",
          "observe"
        ],
        "note": "Los tools validan con Zod, imponen el orden de decisión y hablan con Tavily y DynamoDB."
      },
      {
        "id": "cierre",
        "label": "Cierre y cortes",
        "focus": [
          "think",
          "guard",
          "llm",
          "llmerror",
          "summary"
        ],
        "note": "El agente termina por decisión propia, por una guarda o por un fallo del LLM sin perder lo guardado."
      }
    ]
  },
  "lanes": [
    {
      "id": "agente",
      "label": "LeadAgent (bucle ReAct)"
    },
    {
      "id": "herramientas",
      "label": "Tools y observación"
    },
    {
      "id": "externos",
      "label": "Servicios externos"
    }
  ],
  "phases": [
    {
      "id": "inicio",
      "label": "Entrada",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "bucle",
      "label": "Thought → Action → Observation",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "fin",
      "label": "Cierre",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "input",
    "validate",
    "think",
    "act",
    "tools",
    "observe",
    "guard",
    "summary"
