  "edges": [
    {
      "id": "request",
      "from": "input",
      "to": "validate",
      "variant": "emphasis"
    },
    {
      "id": "start-loop",
      "from": "validate",
      "to": "think",
      "variant": "emphasis"
    },
    {
      "id": "call-llm",
      "from": "think",
      "to": "llm",
      "label": "complete()",
      "variant": "dashed",
      "role": "async"
    },
    {
      "id": "tool-call",
      "from": "think",
      "to": "act",
      "label": "tool_calls",
      "variant": "emphasis"
    },
    {
      "id": "run-tool",
      "from": "act",
      "to": "tools",
      "variant": "emphasis"
    },
    {
      "id": "search",
      "from": "tools",
      "to": "tavily",
      "label": "search_web",
      "variant": "dashed"
    },
    {
      "id": "save",
      "from": "tools",
      "to": "dynamo",
      "label": "save_lead",
      "variant": "dashed"
    },
    {
      "id": "result",
      "from": "tools",
      "to": "observe",
      "label": "resultado o error",
      "variant": "emphasis"
    },
    {
      "id": "check-guards",
      "from": "observe",
      "to": "guard",
      "variant": "emphasis"
    },
    {
      "id": "continue",
      "from": "guard",
      "to": "think",
      "label": "continuar",
      "variant": "dashed",
      "role": "return",
      "route": "up-channel"
    },
    {
      "id": "limit",
      "from": "guard",
      "to": "summary",
      "label": "límite",
      "variant": "emphasis"
    },
    {
      "id": "final-answer",
      "from": "think",
      "to": "summary",
      "label": "sin tool calls",
      "role": "branch",
      "route": "up-channel"
    },
    {
      "id": "llm-fails",
      "from": "llm",
      "to": "llmerror",
      "label": "429 · timeout",
      "variant": "security",
      "role": "error"
    }
