    {
      "id": "think",
      "lane": "agente",
      "col": 2,
      "type": "backend",
      "label": "LLM razona",
      "sublabel": "elige tool o termina",
      "width": 140
    },
    {
      "id": "act",
      "lane": "agente",
      "col": 3,
      "type": "backend",
      "label": "Ejecutar tool",
      "sublabel": "args JSON validados",
      "width": 140
    },
    {
      "id": "observe",
      "lane": "herramientas",
      "col": 4,
      "type": "backend",
      "label": "Observación",
      "sublabel": "resultado al historial",
      "width": 140
    },
    {
      "id": "guard",
      "lane": "agente",
      "col": 4,
      "type": "security",
      "label": "Guardas",
      "sublabel": "iteraciones · leads",
      "width": 140
    },
    {
      "id": "tools",
