{
  "name": "lead-agent",
  "version": "0.1.0",
  "description": "Agente IA para extracción y cualificación de leads B2B (PoC)",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.10"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/app/main.js",
    "start:dev": "nest start --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke-agent.ts",
    "db:init": "node --env-file-if-exists=.env --import tsx scripts/db-init.ts",
    "test:integration": "RUN_INTEGRATION=1 vitest run tests/integration",
    "agent": "node dist/app/cli.js",
    "preagent": "nest build",
    "test:coverage": "vitest run --coverage --coverage.include=src/core --coverage.include=src/infrastructure --coverage.include=src/app",
    "eval": "node --env-file-if-exists=.env --import tsx scripts/eval-agent.ts",
    "aws:secrets": "bash scripts/aws/put-secrets.sh",
    "aws:deploy": "bash scripts/aws/deploy.sh",
    "aws:user": "bash scripts/aws/create-user.sh",
    "aws:destroy": "bash scripts/aws/destroy.sh"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^1.1.2",
    "@anthropic-ai/sdk": "^1.11.0",
    "@aws-sdk/client-dynamodb": "^3.1173.0",
    "@aws-sdk/client-secrets-manager": "^3.1173.0",
    "@aws-sdk/client-sqs": "^3.1173.0",
    "@aws-sdk/lib-dynamodb": "^3.1173.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@tavily/core": "^1.1.0",
    "openai": "^7.62.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^12.0.14",
    "@nestjs/testing": "^12.5.1",
    "@swc/core": "^1.16.22",
    "@types/aws-lambda": "^8.10.164",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
